BINARY := "op-up"

# Default target
default: build

# Build target
build: artifacts
    mkdir -p bin
    go build -o ./bin/{{ BINARY }} .

# Build dependency
artifacts:
    just ../op-deployer/copy-contract-artifacts

# Clean target
clean:
    rm -f {{ BINARY }}
    rm -rf ./bin/{{ BINARY }}

# run
run:
    ./bin/{{ BINARY }}

# run the monitor
monitor:
    #!/usr/bin/env bash
    set -euo pipefail

    cd ../tx-monitor
    npm run dev

l2-interactions:
    #!/usr/bin/env bash
    set -euo pipefail

    PRIVATE_KEY="0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11"

    cd ../packages/contracts-bedrock
    forge script scripts/CGTIntegration.s.sol --private-key $PRIVATE_KEY

# L1 to L2 deposit flow
deposit:
    cd ../packages/contracts-bedrock
    forge script scripts/L1ToL2.s.sol

# L2 to L1 withdrawal flow
withdrawal:
    #!/usr/bin/env bash
    set -euo pipefail

    L1_RPC_URL="http://127.0.0.1:8544"
    L2_RPC_URL="http://127.0.0.1:8545"
    PRIVATE_KEY="0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11"

    echo "Step 1: Running L2ToL1 script..."
    cd ../packages/contracts-bedrock
    output=$(forge script scripts/L2ToL1.s.sol --private-key $PRIVATE_KEY --broadcast)
    echo "$output"

    # Extract values from output
    portal_address=$(echo "$output" | grep "Optimism portal address:" | head -1 | awk '{print $4}')
    dgf_address=$(echo "$output" | grep "DisputeGameFactory address:" | head -1 | awk '{print $3}')
    tx_hash=$(jq -r '.transactions[0].hash' broadcast/L2ToL1.s.sol/901/run-latest.json)

    echo "Portal address: $portal_address"
    echo "DisputeGameFactory address: $dgf_address"
    echo "Withdrawal tx hash: $tx_hash"

    # Check if values are empty
    if [[ -z "$portal_address" ]]; then
        echo "ERROR: Portal address is empty"
        exit 1
    fi
    if [[ -z "$dgf_address" ]]; then
        echo "ERROR: DisputeGameFactory address is empty"
        exit 1
    fi
    if [[ -z "$tx_hash" ]]; then
        echo "ERROR: Transaction hash is empty"
        exit 1
    fi

    echo "Step 2: Waiting for withdrawal to be provable..."
    while true; do
        set +e
        result=$(~/go/bin/withdrawer \
          --fault-proofs \
          --withdrawal $tx_hash \
          --rpc $L1_RPC_URL \
          --l2-rpc $L2_RPC_URL \
          --portal-address $portal_address \
          --dgf-address $dgf_address \
          --private-key ${PRIVATE_KEY#0x} 2>&1)
        exit_code=$?
        set -e

        if [[ $result == *"Withdrawal is not provable"* ]] || [[ $result == *"Error completing withdrawal"* ]]; then
            sleep 12
            continue
        fi

        if [[ $exit_code -eq 0 ]]; then
            echo "================================"
            echo "$result"
            echo "================================"
            break
        fi
    done

    # Get withdrawal hash and dispute game address for finalization
    withdrawal_hash=$(echo "$output" | grep "Withdrawal hash:" | awk '{print $3}')
    proven_timestamp=$(cast call $portal_address "provenWithdrawals(bytes32,address)(address,uint64)" $withdrawal_hash 0x5D284fe6D6AEb73857960a0D041CF394b1198392 --rpc-url http://127.0.0.1:8544)
    dispute_game_address=$(echo "$proven_timestamp" | head -1)

    echo "Step 3: Resolving dispute game..."
    if [[ -n "$dispute_game_address" && "$dispute_game_address" != "0x0000000000000000000000000000000000000000" ]]; then
        echo "Dispute game address: $dispute_game_address"

        sleep 2

        # Resolve root claim if needed
        root_resolved=$(cast call $dispute_game_address "resolvedSubgames(uint256)(bool)" 0 --rpc-url $L1_RPC_URL 2>/dev/null || echo "false")
        if [[ "$root_resolved" == "false" ]]; then
            echo "Resolving root claim..."
            set +e
            resolve_result=$(cast send $dispute_game_address "resolveClaim(uint256,uint256)" 0 0 --private-key $PRIVATE_KEY --rpc-url $L1_RPC_URL 2>&1)
            resolve_exit_code=$?
            set -e

            if [[ $resolve_exit_code -eq 0 ]]; then
                resolve_tx_hash=$(echo "$resolve_result" | grep "transactionHash" | awk '{print $2}')
                echo "Root claim resolved - TX: $resolve_tx_hash"
            fi
        fi

        # Resolve dispute game
        echo "Resolving dispute game..."
        dispute_resolve_result=$(cast send $dispute_game_address "resolve()" --private-key $PRIVATE_KEY --rpc-url $L1_RPC_URL 2>&1)
        dispute_resolve_exit_code=$?
        dispute_tx_hash=$(echo "$dispute_resolve_result" | grep "transactionHash" | awk '{print $2}')
        if [[ $dispute_resolve_exit_code -eq 0 ]]; then
            echo "Dispute game resolved - TX: $dispute_tx_hash"
        else
            echo "ERROR: Failed to resolve dispute game"
            exit 1
        fi

        sleep 2

        # Check final status
        game_status=$(cast call $dispute_game_address "status()(uint8)" --rpc-url $L1_RPC_URL)
        case $game_status in
            0) status_text="IN_PROGRESS" ;;
            1) status_text="CHALLENGER_WINS" ;;
            2) status_text="DEFENDER_WINS" ;;
            *) status_text="UNKNOWN" ;;
        esac
        echo "Dispute game status: $status_text"
    else
        echo "ERROR: Invalid dispute game address"
        exit 1
    fi


    echo "Step 4: Finalizing withdrawal..."
    sleep 10
    result=$(~/go/bin/withdrawer \
        --fault-proofs \
        --withdrawal $tx_hash \
        --rpc $L1_RPC_URL \
        --l2-rpc $L2_RPC_URL \
        --portal-address $portal_address \
        --dgf-address $dgf_address \
        --private-key ${PRIVATE_KEY#0x} 2>&1)
    exit_code=$?
    echo "================================"
    echo "$result"
    echo "================================"


auth-minter:
    #!/usr/bin/env bash
    set -euo pipefail

    PRIVATE_KEY="0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11"
    L2_RPC_URL="http://127.0.0.1:8545"
    LIQUIDITY_CONTROLLER="0x420000000000000000000000000000000000002a"

    cd ../packages/contracts-bedrock
    output=$(forge script scripts/AuthDeposit.s.sol --private-key $PRIVATE_KEY --broadcast)
    echo "$output"

    # extract minter address
    minter_address=$(echo "$output" | grep "Minter to authorize:" | awk '{print $4}')
    echo "Minter address: $minter_address"

    sleep 20

    # check if minter is authorized on L2 LiquidityController
    minter_authorized=$(cast call $LIQUIDITY_CONTROLLER "minters(address)(bool)" $minter_address --rpc-url $L2_RPC_URL)
    echo "Minter authorized: $minter_authorized"

