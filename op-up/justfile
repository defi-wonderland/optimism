BINARY := "op-up"

# Default target
default: build

# Build target
build: artifacts
    mkdir -p bin
    go build -o ./bin/{{ BINARY }} .

# Build dependency
artifacts:
    just ../op-deployer/copy-contract-artifacts

# Clean target
clean:
    rm -f {{ BINARY }}
    rm -rf ./bin/{{ BINARY }}

# run
run:
    ./bin/{{ BINARY }}

# L2 to L1 withdrawal flow
l2-to-l1-withdrawal:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Step 1: Running L2ToL1 script..."
    cd ../packages/contracts-bedrock
    output=$(forge script scripts/L2ToL1.s.sol --private-key 0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11 --broadcast 2>&1)
    echo "$output"

    # Extract values from output
    portal_address=$(echo "$output" | grep "Optimism portal address:" | head -1 | awk '{print $4}')
    dgf_address=$(echo "$output" | grep "DisputeGameFactory address:" | head -1 | awk '{print $3}')

    # Get transaction hash from broadcast file
    tx_hash=$(jq -r '.transactions[0].hash' broadcast/L2ToL1.s.sol/901/run-latest.json)

    # Get proof maturity delay
    proof_maturity_delay=$(cast call $portal_address "proofMaturityDelaySeconds()" --rpc-url http://127.0.0.1:8544)
    proof_maturity_delay_decimal=$((proof_maturity_delay))

    echo "Extracted values:"
    echo "Portal address: $portal_address"
    echo "DisputeGameFactory address: $dgf_address"
    echo "Transaction hash: $tx_hash"
    echo "Proof maturity delay: ${proof_maturity_delay_decimal}s"

    # Check if values are empty
    if [[ -z "$portal_address" ]]; then
        echo "ERROR: Portal address is empty"
        exit 1
    fi
    if [[ -z "$dgf_address" ]]; then
        echo "ERROR: DisputeGameFactory address is empty"
        exit 1
    fi
    if [[ -z "$tx_hash" ]]; then
        echo "ERROR: Transaction hash is empty"
        exit 1
    fi

    echo "Step 2: Proving withdrawal..."
    withdrawal_proved=false
    
    # Try to prove withdrawal (with retry logic)
    while true; do
        set +e  # Disable exit on error
        result=$(~/go/bin/withdrawer \
          --fault-proofs \
          --withdrawal $tx_hash \
          --rpc http://127.0.0.1:8544 \
          --l2-rpc http://127.0.0.1:8545 \
          --portal-address $portal_address \
          --dgf-address $dgf_address \
          --private-key d9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11 2>&1)
        exit_code=$?
        set -e  # Re-enable exit on error

        # Check if withdrawal is not ready yet
        if [[ $result == *"Withdrawal is not provable"* ]] || [[ $result == *"Error proving withdrawal"* ]]; then
            echo "Waiting for L2 block to be processed by L1... (12s)"
            sleep 12
            continue
        fi

        # Check if withdrawal was proved successfully
        if [[ $result == *"Proved withdrawal"* ]]; then
            echo "✅ Withdrawal proved successfully!"
            echo "$result"
            withdrawal_proved=true
            break
        else
            echo "❌ Failed to prove withdrawal:"
            echo "$result"
            exit 1
        fi
    done

    if [[ $withdrawal_proved == true ]]; then
        # Extract dispute game address from portal
        withdrawal_hash=$(echo "$output" | grep "Withdrawal hash:" | awk '{print $3}')
        
        echo "Getting dispute game address..."
        dispute_game_data=$(cast call $portal_address "provenWithdrawals(bytes32,address)(address,uint64)" $withdrawal_hash 0x5D284fe6D6AEb73857960a0D041CF394b1198392 --rpc-url http://127.0.0.1:8544)
        dispute_game_address=$(echo "$dispute_game_data" | head -1)
        
        echo "Dispute game address: $dispute_game_address"
        
        echo "Step 3: Resolving dispute game..."
        echo "Resolving claim 0..."
        cast send $dispute_game_address "resolveClaim(uint256,uint256)" 0 0 --private-key 0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11 --rpc-url http://127.0.0.1:8544 > /dev/null
        
        echo "Resolving dispute game..."
        cast send $dispute_game_address "resolve()" --private-key 0xd9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11 --rpc-url http://127.0.0.1:8544 > /dev/null
        
        # Check game status
        game_status=$(cast call $dispute_game_address "status()" --rpc-url http://127.0.0.1:8544)
        echo "Dispute game status: $((game_status)) (2 = DEFENDER_WINS)"
        
        echo "Step 4: Finalizing withdrawal..."
        
        final_result=$(~/go/bin/withdrawer \
          --fault-proofs \
          --withdrawal $tx_hash \
          --rpc http://127.0.0.1:8544 \
          --l2-rpc http://127.0.0.1:8545 \
          --portal-address $portal_address \
          --dgf-address $dgf_address \
          --private-key d9fb56b9574ed61ab0478a607166eeb3a80b1b91ab1bf00f45932105d07b5e11 2>&1)
        
        if [[ $final_result == *"Completed withdrawal"* ]]; then
            echo "🎉 WITHDRAWAL COMPLETED SUCCESSFULLY! 🎉"
            echo "$final_result"
        else
            echo "❌ Failed to finalize withdrawal:"
            echo "$final_result"
        fi
    fi

