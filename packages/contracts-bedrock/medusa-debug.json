{
  "slither": {
    "useSlither": true,
    "cachePath": "slither_results.json",
    "args": ["--foundry-out-directory", "artifacts"]
  },
  "fuzzing": {
    "timeout": 5,
    "coverageEnabled": false,
    "coverageFormats": [],
    "targetContracts": ["FuzzTest"],
    "predeployedContracts": {
      "Deployer815": "0x4200000000000000000000000000000000000815",
      "Deployer825": "0x4200000000000000000000000000000000000825"
    },
    "testing": {
      "assertionTesting": {
        "enabled": true,
        "panicCodeConfig": {
          "failOnAssertion": true
        }
      }
    }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "solcVersion": "",
      "exportDirectory": "",
      "args": ["--foundry-compile-all", "--foundry-out-directory", "artifacts"]
    }
  }
}
